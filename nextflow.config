// ── Plugins ───────────────────────────────────────────────────────────────────
// nf-schema validates params against nextflow_schema.json and the samplesheet
// against assets/schema_input.json at launch time (see validateParameters() in
// main.nf). Pinned so a plugin release cannot silently change validation.
plugins {
    id 'nf-schema@2.1.1'
}

manifest {
    name            = 'lorerna'
    author          = 'Darius'
    homePage        = 'https://github.com/dariusng28-collab/LoReRNA'
    description     = 'Long-read RNA-seq: MisER → IsoQuant → Oarfish → swish (fishpond)'
    mainScript      = 'main.nf'
    version         = '1.0.0'
    nextflowVersion = '>=23.10.0'
}

def check_max(obj, type) {
    if (type == 'memory') {
        try { return obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1
                     ? params.max_memory as nextflow.util.MemoryUnit : obj } catch (all) { return obj }
    } else if (type == 'time') {
        try { return obj.compareTo(params.max_time as nextflow.util.Duration) == 1
                     ? params.max_time as nextflow.util.Duration : obj } catch (all) { return obj }
    } else if (type == 'cpus') {
        try { return Math.min(obj, params.max_cpus as int) } catch (all) { return obj }
    }
}

params {

    // ── I/O ───────────────────────────────────────────────────────────────
    outdir          = 'results'
    samplesheet     = null
    reference_fasta = null
    reference_gtf   = null
    reference_db    = null
    reference_bed12 = null
    publish_mode    = 'copy'

    // ── Site resource caps ────────────────────────────────────────────────
    max_cpus   = 16
    max_memory = '128.GB'
    max_time   = '72.h'

    // ── Containers ────────────────────────────────────────────────────────
    container_lorerna = 'docker://dariusng28/lorerna:1.1.0'
    container_miser   = 'docker://dariusng28/miser:1.1.0'

    // ── MisER ─────────────────────────────────────────────────────────────
    miser_exe          = 'MisER'
    miser_args         = '-s 10 -d 0.2 -f 20 --allTranscripts --fixFlankLen --strandSpecific --setTag'
    miser_scratch_root = null   // null = auto-resolve; see miser.nf fallback chain

    // ── MisER QC ──────────────────────────────────────────────────────────
    miser_qc_min_support = 1
    miser_qc_all_events  = false

    // ── IsoQuant ──────────────────────────────────────────────────────────
    isoquant_exe             = 'isoquant'
    isoquant_data_type       = 'nanopore'
    isoquant_args            = '--count_exons'
    isoquant_complete_genedb = true   // always true for GENCODE/Ensembl

    // ── Reference utilities ───────────────────────────────────────────────
    gffcompare_exe = 'gffcompare'
    gffread_exe    = 'gffread'
    samtools_exe   = 'samtools'

    // ── Oarfish ───────────────────────────────────────────────────────────
    oarfish_exe            = 'oarfish'
    oarfish_num_bootstraps = 100
    oarfish_filter_group   = 'no-filters'
    seq_tech = 'ont-drna'
    oarfish_args           = '--model-coverage'

    // ── R ─────────────────────────────────────────────────────────────────
    rscript_exe = 'Rscript'

    // ── swish ─────────────────────────────────────────────────────────────
    swish_condition_a = 'Control'
    swish_condition_b = 'KD'
    swish_min_count   = 10
    swish_min_n       = 3
    swish_nperms      = 100
    swish_alpha       = 0.05

    // ── swish_plots ───────────────────────────────────────────────────────
    swish_top_n = 30   // top-N features in heatmaps
}

// ── Process configuration ─────────────────────────────────────────────────────
// Resource labels and retry policy live in conf/base.config; per-process settings
// (container routing) in conf/modules.config. Site configs passed with -c are
// applied after these and override them.
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// ── Profiles ──────────────────────────────────────────────────────────────────
profiles {

    standard  { process.executor = 'local' }

    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    conda {
        conda.enabled  = true
        conda.useMamba = true
        process {
            withName: 'MISER' {
                conda = "${projectDir}/containers/environment_miser.yml"
            }
            withName: 'SAMTOOLS_SORT_INDEX|SAMTOOLS_STATS|CLEAN_BAM|MISER_QC|MISER_QC_MERGE|ISOQUANT|ISOQUANT_QC|PREPARE_OARFISH_REFERENCE|OARFISH|SWISH|SWISH_PLOTS|MULTIQC' {
                conda = "${projectDir}/containers/environment.yml"
            }
        }
    }

    test {
        params {
            max_cpus   = 4
            max_memory = '16.GB'
            max_time   = '2.h'
            oarfish_num_bootstraps = 10
            swish_nperms           = 10
            swish_min_n            = 1
            swish_top_n            = 10
            outdir = 'test_results'
        }
    }
}

// ── Execution reports ─────────────────────────────────────────────────────────
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html";      overwrite = true }
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
    fields    = 'task_id,name,status,exit,cpus,memory,time,realtime,%cpu,rss,peak_rss,vmem,peak_vmem,rchar,wchar'
}
