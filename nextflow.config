manifest {
    name            = 'lorerna'
    author          = 'Darius'
    description     = 'Long-read RNA-seq pipeline: MisER → IsoQuant → Oarfish → swish (fishpond)'
    version         = '1.1.1'
    nextflowVersion = '>=23.10.0'
}

// ── Helper: cap resource requests at site-defined maxima ──────────────────────
// Called in every process label below. Site configs override max_cpus,
// max_memory, max_time to match their node limits — the pipeline never
// needs to know which cluster it is running on.
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else return obj
        } catch (all) { return obj }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else return obj
        } catch (all) { return obj }
    } else if (type == 'cpus') {
        try { return Math.min(obj, params.max_cpus as int) }
        catch (all) { return obj }
    }
}

// ── Parameters ────────────────────────────────────────────────────────────────
params {

    // ── I/O ───────────────────────────────────────────────────────────────
    outdir          = 'results'
    samplesheet     = null
    reference_fasta = null
    reference_gtf   = null    // provide exactly one of reference_gtf or reference_db
    reference_db    = null    // pre-built gffutils DB — faster for repeated IsoQuant runs
    reference_bed12 = null

    // ── Samplesheet ───────────────────────────────────────────────────────
    // Three columns, always:
    //   sample_name   unique sample identifier
    //   condition     group label  e.g. WT, KO, KD, Control
    //   bam           absolute path to genome-aligned BAM
    //
    // Analysis design is controlled by flags below, not samplesheet columns.

    // ── Site resource caps ────────────────────────────────────────────────
    // Pipeline defaults — safe for a modern workstation.
    // Override in a site config (-c conf/your_cluster.config):
    //   params { max_cpus = 36; max_memory = '128.GB'; max_time = '72.h' }
    max_cpus   = 16
    max_memory = '128.GB'
    max_time   = '72.h'

    // ── Sequencing technology ─────────────────────────────────────────────
    // Controls the minimap2 preset inside oarfish.
    // ont-drna  — Oxford Nanopore direct RNA-seq (default)
    // ont-cdna  — Oxford Nanopore cDNA
    seq_tech = 'ont-drna'

    // ── Container images ──────────────────────────────────────────────────
    // docker:// URIs are resolved automatically by Singularity, Apptainer,
    // and Docker at runtime — no manual SIF building required.
    // Images are pulled once and cached (see singularity.cacheDir in site configs).
    //
    // To build and push your own images:
    //   docker build -f containers/Dockerfile       -t dariusng28/lorerna:1.0.0 .
    //   docker build -f containers/Dockerfile.miser -t dariusng28/miser:1.0.0   .
    //   docker push dariusng28/lorerna:1.0.0
    //   docker push dariusng28/miser:1.0.0
    container_lorerna = 'docker://dariusng28/lorerna:1.0.0'
    container_miser   = 'docker://dariusng28/miser:1.0.0'
    publish_mode      = 'copy'

    // ── MisER ─────────────────────────────────────────────────────────────
    miser_exe         = 'MisER'
    miser_args        = '-s 10 -d 0.2 -f 20 --allTranscripts --fixFlankLen --strandSpecific --setTag'
    miser_scratch_root = null   // defaults to NXF_SCRATCH → TMPDIR → /scratch0/$USER → PWD

    // ── IsoQuant ──────────────────────────────────────────────────────────
    isoquant_exe             = 'isoquant'
    isoquant_data_type       = 'nanopore'
    isoquant_args            = '--count_exons'
    // Recommended true for complete annotations (GENCODE, Ensembl).
    // Avoids redundant gffutils DB construction on each run.
    isoquant_complete_genedb = false

    // ── Reference utilities ───────────────────────────────────────────────
    gffcompare_exe = 'gffcompare'
    gffread_exe    = 'gffread'
    samtools_exe   = 'samtools'

    // ── Oarfish ───────────────────────────────────────────────────────────
    oarfish_exe            = 'oarfish'
    oarfish_num_bootstraps = 100          // 100 required for stable swish DTU estimates
    oarfish_filter_group   = 'no-filters' // EM handles multi-mappers probabilistically
    oarfish_args           = '--model-coverage' // corrects 3' positional bias (dRNA)

    // ── R ─────────────────────────────────────────────────────────────────
    rscript_exe = 'Rscript'

    // ── swish (fishpond) ──────────────────────────────────────────────────
    // Three analyses: DTE (transcript expression), DTU (isoform switching),
    // DGE (gene expression aggregated from transcripts).
    //
    // swish_condition_a  reference condition — log2FC denominator
    // swish_condition_b  test condition      — log2FC numerator
    //   log2FC > 0 means higher in condition_b
    //
    // swish_paired — true: activates fishpond paired Wilcoxon test.
    //   Samples must be in matched pairs across conditions in the samplesheet
    //   (row order defines pairing: row 1 Control paired with row 1 KD, etc).
    //
    // swish_batch  — true: passes condition as a batch covariate to swish().
    //   Note: paired and batch are mutually exclusive in most fishpond versions.
    //
    // Both default to false — standard unpaired analysis.
    swish_condition_a   = 'Control'
    swish_condition_b   = 'KD'
    swish_condition_col = 'condition'
    swish_paired        = false
    swish_batch         = false
    swish_min_count     = 10
    swish_min_n         = 3
    swish_nperms        = 100
    swish_alpha         = 0.05
}

// ── Process defaults ──────────────────────────────────────────────────────────
process {

    // OOM and scheduler kill codes → retry with doubled memory
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247]
                      ? 'retry' : 'finish' }
    maxRetries = 2
    maxErrors  = -1

    // ── Resource labels ────────────────────────────────────────────────────

    withLabel:process_single {
        cpus   = { check_max(1,                    'cpus')   }
        memory = { check_max(8.GB  * task.attempt, 'memory') }
        time   = { check_max(12.h  * task.attempt, 'time')   }
    }
    withLabel:process_low {
        cpus   = { check_max(2,                    'cpus')   }
        memory = { check_max(4.GB  * task.attempt, 'memory') }
        time   = { check_max(4.h   * task.attempt, 'time')   }
    }
    withLabel:process_medium {
        cpus   = { check_max(4,                    'cpus')   }
        memory = { check_max(16.GB * task.attempt, 'memory') }
        time   = { check_max(12.h  * task.attempt, 'time')   }
    }
    withLabel:process_sort {
        // SAMTOOLS_SORT_INDEX: ONT BAMs need 16 GB for in-memory sort.
        // 4 threads × -m 3G = 12 GB active + I/O headroom within 16 GB.
        cpus   = { check_max(4,                    'cpus')   }
        memory = { check_max(16.GB * task.attempt, 'memory') }
        time   = { check_max(12.h  * task.attempt, 'time')   }
    }
    withLabel:process_high {
        // PREPARE_OARFISH_REFERENCE, SWISH.
        // SWISH: 32 GB for 7-sample × 100-bootstrap infRep matrices.
        cpus   = { check_max(8,                    'cpus')   }
        memory = { check_max(32.GB * task.attempt, 'memory') }
        time   = { check_max(48.h  * task.attempt, 'time')   }
    }
    withLabel:process_very_high {
        // ISOQUANT, OARFISH: 16 threads, 64 GB, up to 72 h.
        cpus   = { check_max(16,                   'cpus')   }
        memory = { check_max(64.GB * task.attempt, 'memory') }
        time   = { check_max(72.h  * task.attempt, 'time')   }
    }
    withLabel:process_miser {
        // MisER: 4 cores, 64 GB, 48 h — matches validated bash script.
        cpus   = { check_max(4,                    'cpus')   }
        memory = { check_max(64.GB * task.attempt, 'memory') }
        time   = { check_max(48.h  * task.attempt, 'time')   }
    }

    // ── Container routing ──────────────────────────────────────────────────
    withName: 'MISER' {
        container = params.container_miser
    }
    withName: 'SAMTOOLS_SORT_INDEX|ISOQUANT|PREPARE_OARFISH_REFERENCE|OARFISH|SWISH' {
        container = params.container_lorerna
    }
}

// ── Profiles ──────────────────────────────────────────────────────────────────
// Profiles control the container RUNTIME only — they are pipeline-owned
// and portable across every cluster.
//
// Cluster-specific settings (executor, queues, memory caps, bind mounts)
// live in site configs under conf/ and are loaded with -c, not -profile:
//   nextflow run main.nf -profile singularity -c conf/ucl_sge.config
//
// Available site configs:
//   conf/ucl_sge.config  — UCL morecambe2 SGE cluster
//
// To add a new cluster, copy conf/ucl_sge.config, adjust the three params
// (max_cpus, max_memory, max_time), the clusterOptions memory formula, and
// the executor block — no changes to this file needed.

profiles {

    // ── standard ─────────────────────────────────────────────────────────
    // Local execution, no containers. Tools must be on PATH.
    // Useful for quick local tests when containers are not available.
    standard {
        process.executor = 'local'
    }

    // ── docker ───────────────────────────────────────────────────────────
    // Local execution with Docker. Runs as current user to avoid root-owned
    // output files. Docker Desktop must be running.
    //
    // Usage:
    //   nextflow run main.nf -profile docker [params]
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        process {
            shell = ['/bin/bash', '-euo', 'pipefail']
        }
    }

    // ── singularity ───────────────────────────────────────────────────────
    // Local or HPC execution with Singularity / Apptainer.
    // Images are pulled from docker:// URIs and cached in NXF_SINGULARITY_CACHEDIR
    // (set in your environment or site config) — pulled once, reused forever.
    //
    // Usage (standalone):
    //   nextflow run main.nf -profile singularity [params]
    //
    // Usage with a site config (recommended on HPC):
    //   nextflow run main.nf -profile singularity -c conf/ucl_sge.config [params]
    //
    // The site config adds: executor, queue, per-core memory, bind mounts,
    // cacheDir. The profile adds: singularity.enabled = true.
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        process {
            shell = ['/bin/bash', '-euo', 'pipefail']
        }
    }

    // ── conda ─────────────────────────────────────────────────────────────
    // Local execution with conda/mamba environments.
    // Slower first run (environment solve + install); no container runtime needed.
    // Conda environments are created from containers/environment.yml and
    // containers/environment_miser.yml. Reused across runs once built.
    //
    // Usage:
    //   nextflow run main.nf -profile conda [params]
    conda {
        conda.enabled     = true
        conda.useMamba    = true   // faster solves; falls back to conda if mamba absent
        process {
            shell = ['/bin/bash', '-euo', 'pipefail']
            withName: 'MISER' {
                conda = "${projectDir}/containers/environment_miser.yml"
            }
            withName: 'SAMTOOLS_SORT_INDEX|ISOQUANT|PREPARE_OARFISH_REFERENCE|OARFISH|SWISH' {
                conda = "${projectDir}/containers/environment.yml"
            }
        }
    }

    // ── test ──────────────────────────────────────────────────────────────
    // Minimal local run on a small public dataset for CI and smoke testing.
    // Uses a 1 Mb region of chr22 (GRCh38) with 3 Control + 3 KD samples.
    // Combine with a runtime profile:
    //   nextflow run main.nf -profile test,docker
    //   nextflow run main.nf -profile test,singularity -c conf/ucl_sge.config
    //
    // Test data is hosted at:
    //   https://github.com/vyplab/lorerna-test-data
    test {
params {
            // Resource caps — keeps test jobs fast on a laptop
            max_cpus   = 4
            max_memory = '16.GB'
            max_time   = '2.h'

            // Test data — hosted at https://github.com/dariusng28-collab/lorerna-test-data
            // TODO: create test data repository and uncomment URLs below
            // samplesheet     = 'https://raw.githubusercontent.com/dariusng28-collab/lorerna-test-data/main/samplesheet.csv'
            // reference_fasta = 'https://raw.githubusercontent.com/dariusng28-collab/lorerna-test-data/main/GRCh38_chr22_1Mb.fa'
            // reference_gtf   = 'https://raw.githubusercontent.com/dariusng28-collab/lorerna-test-data/main/gencode_v45_chr22_1Mb.gtf'
            // reference_bed12 = 'https://raw.githubusercontent.com/dariusng28-collab/lorerna-test-data/main/gencode_v45_chr22_1Mb.bed12'

            // Reduced parameters for speed
            oarfish_num_bootstraps = 10
            swish_nperms           = 10
            swish_min_n            = 1

            outdir = 'test_results'
        }
    }
}

// ── Pipeline execution reports ────────────────────────────────────────────────
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html";      overwrite = true }

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
    fields    = 'task_id,name,status,exit,cpus,memory,time,realtime,%cpu,rss,peak_rss,vmem,peak_vmem,rchar,wchar'
}
