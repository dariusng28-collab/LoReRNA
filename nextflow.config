manifest {
    name = 'longread-rnaseq-miser-isoquant-oarfish-swish'
    author = 'OpenAI Codex'
    description = 'Long-read RNA-seq pipeline scaffold for MisER, IsoQuant, Oarfish, and Swish'
    version = '0.1.0'
    nextflowVersion = '>=23.10.0'
}

params {
    outdir = 'results'
    samplesheet = null
    metadata = null
    reference_fasta = null
    reference_gtf = null
    reference_bed12 = null

    seq_tech = 'ont-cdna'
    threads = 8
    publish_mode = 'copy'
    container_image = 'longread-rnaseq-miser-isoquant-oarfish-swish:0.1.0'

    miser_exe = 'miser'
    miser_args = ''

    isoquant_exe = 'isoquant.py'
    isoquant_data_type = 'nanopore'
    isoquant_prefix = 'longread'
    isoquant_args = '--count_exons'

    gffread_exe = 'gffread'
    samtools_exe = 'samtools'

    oarfish_exe = 'oarfish'
    oarfish_num_bootstraps = 30
    oarfish_filter_group = 'nanocount-filters'
    oarfish_args = '--model-coverage'

    python_exe = 'python'
    rscript_exe = 'Rscript'

    swish_condition_col = 'condition'
    swish_pair_col = null
    swish_batch_col = null
    swish_min_count = 10
    swish_min_n = 3
    swish_nperms = 100
    swish_alpha = 0.05
}

process {
    executor = 'local'
    withLabel:process_low {
        cpus = 2
        memory = '4 GB'
        time = '2h'
    }
    withLabel:process_medium {
        cpus = 4
        memory = '8 GB'
        time = '6h'
    }
    withLabel:process_high {
        cpus = 8
        memory = '16 GB'
        time = '24h'
    }
}

profiles {
    standard {
    }

    docker {
        docker.enabled = true
        process.container = params.container_image
        process.shell = ['/bin/bash', '-euo', 'pipefail']
    }

    apptainer {
        apptainer.enabled = true
        process.container = params.container_image
        process.shell = ['/bin/bash', '-euo', 'pipefail']
    }
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline.html"
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/report.html"
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace.txt"
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/dag.html"
}
