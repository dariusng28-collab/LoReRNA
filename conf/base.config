/*
========================================================================================
    LoReRNA — base process resource configuration
========================================================================================
    Default CPU / memory / time for each process label, plus the retry policy.

    Resources scale with `task.attempt`, so a process that is killed for running
    out of memory is retried with more. `check_max()` (defined in nextflow.config)
    clamps every request to --max_cpus / --max_memory / --max_time so a request can
    never exceed what the site allows.

    Site configs (conf/sge.config, conf/slurm.config, conf/lsf.config, or your own
    passed with -c) are applied after this file and override anything here.

    NOTE: none of these directives are part of the Nextflow task hash, so changing
    resources here does not invalidate a resumed run.
----------------------------------------------------------------------------------------
*/

process {

    // Retry on out-of-memory / killed-process exit codes; fail fast otherwise.
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247]
                      ? 'retry' : 'finish' }
    maxRetries = 2
    maxErrors  = -1

    withLabel:process_single    { cpus = { check_max(1,  'cpus') }; memory = { check_max(8.GB  * task.attempt, 'memory') }; time = { check_max(12.h  * task.attempt, 'time') } }
    withLabel:process_low       { cpus = { check_max(2,  'cpus') }; memory = { check_max(8.GB  * task.attempt, 'memory') }; time = { check_max(4.h   * task.attempt, 'time') } }
    withLabel:process_medium    { cpus = { check_max(4,  'cpus') }; memory = { check_max(16.GB * task.attempt, 'memory') }; time = { check_max(12.h  * task.attempt, 'time') } }
    withLabel:process_sort      { cpus = { check_max(4,  'cpus') }; memory = { check_max(16.GB * task.attempt, 'memory') }; time = { check_max(12.h  * task.attempt, 'time') } }
    withLabel:process_high      { cpus = { check_max(8,  'cpus') }; memory = { check_max(32.GB * task.attempt, 'memory') }; time = { check_max(48.h  * task.attempt, 'time') } }
    withLabel:process_very_high { cpus = { check_max(16, 'cpus') }; memory = { check_max(64.GB * task.attempt, 'memory') }; time = { check_max(72.h  * task.attempt, 'time') } }

    // MisER is single-threaded but memory- and time-hungry; it also needs
    // node-local scratch (see --miser_scratch_root and the site configs).
    withLabel:process_miser     { cpus = { check_max(1,  'cpus') }; memory = { check_max(64.GB * task.attempt, 'memory') }; time = { check_max(48.h  * task.attempt, 'time') } }
}
