/*
========================================================================================
    LoReRNA — base process resource configuration
========================================================================================
    Default CPU / memory / time for each process label, plus the retry policy.

    Resources scale with `task.attempt`, so a process that is killed for running
    out of memory is retried with more. `process.resourceLimits` (Nextflow >= 24.04)
    clamps every request — including the scaled-up retry — so a request can never
    exceed what the site allows. This replaces the old check_max()/params.max_*
    mechanism, which had to be maintained by hand.

    base.config deliberately sets NO resourceLimits — the ceiling is a
    site-specific fact. Each site config (conf/sge.config, conf/slurm.config,
    conf/lsf.config, conf/test.config, or your own passed with -c) sets its own
    `process.resourceLimits` and, being applied after this file, wins. A run with
    no site config (e.g. -profile standard on a workstation) is left uncapped,
    exactly as before this migration.

    NOTE: none of these directives are part of the Nextflow task hash, so changing
    resources here does not invalidate a resumed run.
----------------------------------------------------------------------------------------
*/

process {

    // Defaults for any process that carries no withLabel. Every LoReRNA process
    // is labelled, so these are a safety net rather than something in daily use —
    // without them an unlabelled process would inherit Nextflow's own defaults
    // (1 CPU, no memory or time limit), which schedulers reject or mis-size.
    cpus   = 1
    memory = { 6.GB * task.attempt }
    time   = { 4.h  * task.attempt }

    // Retry on out-of-memory / killed-process exit codes; fail fast otherwise.
    errorStrategy = { task.exitStatus in [104, 134, 137, 138, 139, 140, 143, 247]
                      ? 'retry' : 'finish' }
    maxRetries = 2
    maxErrors  = -1

    withLabel:process_single    { cpus = 1;  memory = { 8.GB  * task.attempt }; time = { 12.h * task.attempt } }
    withLabel:process_low       { cpus = 2;  memory = { 8.GB  * task.attempt }; time = { 4.h  * task.attempt } }
    withLabel:process_medium    { cpus = 4;  memory = { 16.GB * task.attempt }; time = { 12.h * task.attempt } }
    withLabel:process_sort      { cpus = 4;  memory = { 16.GB * task.attempt }; time = { 12.h * task.attempt } }
    withLabel:process_high      { cpus = 8;  memory = { 32.GB * task.attempt }; time = { 48.h * task.attempt } }
    withLabel:process_very_high { cpus = 16; memory = { 64.GB * task.attempt }; time = { 72.h * task.attempt } }

    // MisER is single-threaded but memory- and time-hungry; it also needs
    // node-local scratch (see --miser_scratch_root and the site configs).
    withLabel:process_miser     { cpus = 1;  memory = { 64.GB * task.attempt }; time = { 48.h * task.attempt } }
}
