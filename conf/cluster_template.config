// ============================================================================
// LoReRNA — cluster site config template
//
// Copy this file, rename it for your cluster, and fill in the sections below.
// Load it with -c when running the pipeline:
//
//   nextflow run vyplab/lorerna -profile singularity -c conf/your_cluster.config
//
// This file sets cluster-specific concerns only (executor, queues, memory
// format, container bind mounts). The pipeline itself does not change.
// ============================================================================

// ── Executor ─────────────────────────────────────────────────────────────────
// Uncomment the block matching your scheduler.

// SGE
executor {
    name      = 'sge'
    queueSize = 50
}

// SLURM
// executor {
//     name      = 'slurm'
//     queueSize = 50
// }

// LSF
// executor {
//     name      = 'lsf'
//     queueSize = 50
// }

// ── Container runtime ─────────────────────────────────────────────────────────
// Singularity/Apptainer — set cacheDir to a shared filesystem path so images
// are pulled once and reused by all users and jobs.
// Set runOptions bind mounts to match your cluster's filesystem layout.

singularity.autoMounts = false
singularity.runOptions = "-B /path/to/data,${HOME}"
singularity.cacheDir   = "/path/to/shared/singularity_cache"

// Apptainer (uncomment if your cluster uses apptainer instead of singularity)
// apptainer.autoMounts = false
// apptainer.runOptions = "-B /path/to/data,${HOME}"
// apptainer.cacheDir   = "/path/to/shared/singularity_cache"

// ── Site resource caps ────────────────────────────────────────────────────────
// Set these to match your cluster's node limits.
// check_max() in nextflow.config ensures no process exceeds these values.

params {
    max_cpus   = 32       // maximum cores available per node
    max_memory = '128.GB' // maximum RAM available per node
    max_time   = '72.h'   // queue walltime limit
}

// ── Process defaults ──────────────────────────────────────────────────────────

process {

    executor = 'sge'      // match your scheduler above
    queue    = 'all.q'    // default queue — override per label if needed
    scratch  = true       // use node-local scratch (recommended)

    // SGE: clusterOptions sets per-core memory in the format your cluster expects.
    // The formula below (total MB / cpus) is standard for SGE clusters that
    // charge memory per core. Adjust if your scheduler uses different syntax.
    clusterOptions = {
        def mem_per_core = (task.memory.mega / task.cpus).toInteger()
        "-S /bin/bash -l tmem=${mem_per_core}M,h_vmem=${mem_per_core}M"
    }

    // SLURM: replace clusterOptions with:
    // clusterOptions = { "--mem=${task.memory.mega}M" }

    // LSF: replace clusterOptions with:
    // clusterOptions = { "-R 'rusage[mem=${task.memory.mega}MB]'" }
}
