// ============================================================================
// conf/validate.config — LoReRNA v1.0.0 validation config
//
// Stack on top of your site config for a fast 2-sample validation run:
//
//   nextflow run main.nf \
//     -profile singularity \
//     -c conf/sge.config \
//     -c conf/validate.config \
//     --samplesheet test/samplesheet_2sample.csv \
//     ...
//
// What this changes vs a production run:
//   1. oarfish_num_bootstraps  → 10  (vs 100)
//   2. swish_nperms            → 10  (vs 100)
//   3. swish_min_n             → 1   (vs 3, allows 1 sample per condition)
//   4. swish_top_n             → 10  (smaller heatmaps)
//   5. outdir                  → lorerna_validation (keeps production results clean)
//   6. publish_mode            → symlink (faster than copy)
// ============================================================================

params {
    oarfish_num_bootstraps = 10
    swish_nperms           = 10
    swish_min_n            = 1
    swish_top_n            = 10
    outdir                 = 'lorerna_validation'
    publish_mode           = 'symlink'
}
