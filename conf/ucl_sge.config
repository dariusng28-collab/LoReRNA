// ============================================================================
// LoReRNA — UCL morecambe2 SGE site config
//
// Usage:
//   nextflow run dariusng28-collab/LoReRNA \
//       -profile singularity \
//       -c conf/ucl_sge.config \
//       --samplesheet samplesheet.csv ...
//
// morecambe2 specs (surveyed May 2026):
//   Nodes  : mix of 192-core and 256-core nodes, up to 128 GB RAM
//   Queues : cpu.q (h_rt = 2000:0:0)   ← use this
//            all.q (h_rt = 0:1:0)       ← do NOT use, 1 min limit
//   PE     : smp
//   Singularity: 3.8.5 at /usr/bin/singularity (system-wide, no module load)
//
// CPU strategy:
//   All processes are capped at 4 CPUs regardless of label to ensure jobs
//   start quickly on a shared cluster. Memory is set to what each process
//   actually needs — the scheduler only needs to find 4 free slots rather
//   than 8 or 16, reducing queue wait significantly.
//
// IMPORTANT — UCL SGE memory accounting:
//   UCL SGE charges memory PER SLOT (core). tmem and h_vmem must be
//   per-core values. SGE multiplies by the number of slots (cpus) to
//   determine total node allocation.
//
//   mem_per_core = total_memory / cpus
//   SGE allocates: cpus × mem_per_core = total_memory
//
//   SGE submission per label (all at 4 CPUs):
//     process_single    → -pe smp 4  -l tmem=2048M,h_vmem=2048M   (8 GB  total)
//     process_low       → -pe smp 4  -l tmem=1024M,h_vmem=1024M   (4 GB  total)
//     process_medium    → -pe smp 4  -l tmem=4096M,h_vmem=4096M   (16 GB total)
//     process_sort      → -pe smp 4  -l tmem=4096M,h_vmem=4096M   (16 GB total)
//     process_high      → -pe smp 4  -l tmem=8192M,h_vmem=8192M   (32 GB total)
//     process_very_high → -pe smp 4  -l tmem=16384M,h_vmem=16384M (64 GB total)
//     process_miser     → -pe smp 4  -l tmem=16384M,h_vmem=16384M (64 GB total)
// ============================================================================

// ── Executor ──────────────────────────────────────────────────────────────────

executor {
    name      = 'sge'
    queueSize = 50
}

// ── Singularity ───────────────────────────────────────────────────────────────
// System-wide at /usr/bin/singularity — no module load needed.
// autoMounts disabled — HOME and PWD not auto-mounted on morecambe2.
// cacheDir on shared SAN so images are pulled once and shared across lab users.

singularity.autoMounts = false
singularity.runOptions = "-B ${HOME},${PWD}"
singularity.cacheDir   = "/SAN/vyplab/alb_projects/singularity_cache"

// ── Site resource caps ────────────────────────────────────────────────────────

params {
    max_cpus   = 4
    max_memory = '256.GB'
    max_time   = '240.h'
}

// ── Process defaults ──────────────────────────────────────────────────────────

process {

    executor = 'sge'
    penv     = 'smp'
    queue    = 'cpu.q'
    scratch  = true

    // UCL SGE charges memory per slot (core).
    // Divide total memory by cpus to get per-core value for tmem/h_vmem.
    // toInteger() required — SGE rejects decimal MB values.
    clusterOptions = {
        def mem_per_core = (task.memory.mega / task.cpus).toInteger()
        "-S /bin/bash -l tmem=${mem_per_core}M,h_vmem=${mem_per_core}M"
    }

    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247]
                      ? 'retry' : 'finish' }
    maxRetries = 2
    maxErrors  = -1

    // ── Resource labels ───────────────────────────────────────────────────
    // All labels fixed at 4 CPUs for faster queue start on morecambe2.
    // Memory reflects what each process actually needs — unchanged from
    // the public nextflow.config defaults.

    withLabel:process_single {
        cpus   = 1
        memory = { check_max(8.GB  * task.attempt, 'memory') }
        time   = { check_max(12.h  * task.attempt, 'time')   }
    }
    withLabel:process_low {
        cpus   = 2
        memory = { check_max(8.GB  * task.attempt, 'memory') }
        time   = { check_max(4.h   * task.attempt, 'time')   }
    }
    withLabel:process_medium {
        cpus   = 4
        memory = { check_max(16.GB * task.attempt, 'memory') }
        time   = { check_max(12.h  * task.attempt, 'time')   }
    }
    withLabel:process_sort {
        cpus   = 4
        memory = { check_max(16.GB * task.attempt, 'memory') }
        time   = { check_max(12.h  * task.attempt, 'time')   }
    }
    withLabel:process_high {
        cpus   = 4
        memory = { check_max(128.GB * task.attempt, 'memory') }
        time   = { check_max(48.h  * task.attempt, 'time')   }
    }
    withLabel:process_very_high {
        cpus   = 4
        memory = { check_max(256.GB * task.attempt, 'memory') }
        time   = { check_max(72.h  * task.attempt, 'time')   }
    }
    withLabel:process_miser {
        cpus   = 4
        memory = { check_max(256.GB * task.attempt, 'memory') }
        time   = { check_max(48.h  * task.attempt, 'time')   }
    }
}