// ============================================================================
// LoReRNA — generic SLURM site config
//
// Tested on standard SLURM clusters (Alma/Rocky Linux 8/9).
// Adjust queue, account, and scratch paths for your site.
//
// Changes from the SGE example:
//   clusterOptions : SGE -l tmem/h_vmem  →  SLURM --mem-per-cpu
//   scratch flag   : tscratch=60G        →  --tmp=61440  (MB units)
//   scratch path   : /scratch0           →  $SLURM_TMPDIR (auto-set by scheduler)
//   bind mount     : -B /scratch0        →  not needed; SLURM_TMPDIR visible in container
//
// For most SLURM sites, the MISER containerOptions line can be removed entirely
// because SLURM_TMPDIR is set in the job environment and Singularity inherits it.
// Add it back (-B $SLURM_TMPDIR) only if your site uses strict namespace isolation.
// ============================================================================

executor {
    name      = 'slurm'
    queueSize = 50
}

// ── Singularity ───────────────────────────────────────────────────────────────
singularity.autoMounts = true   // SLURM clusters usually support autoMounts
singularity.cacheDir   = "/path/to/shared/singularity_cache"  // ← update this

// ── Site resource caps ────────────────────────────────────────────────────────
params {
    max_cpus   = 16
    max_memory = '256.GB'
    max_time   = '240.h'
}

// ── Process defaults ──────────────────────────────────────────────────────────
process {
    executor = 'slurm'
    queue    = 'compute'      // ← update to your partition name
    scratch  = true

    clusterOptions = {
        // SLURM memory is per-job by default; --mem-per-cpu converts to per-core.
        def mpc = (task.memory.mega / task.cpus).toInteger()
        "--account=my_project --mem-per-cpu=${mpc}M"   // ← update account
    }
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247]
                      ? 'retry' : 'finish' }
    maxRetries = 2
    maxErrors  = -1

    withLabel:process_single    { cpus = 1;  memory = { 8.GB  * task.attempt }; time = { 12.h  * task.attempt } }
    withLabel:process_low       { cpus = 2;  memory = { 8.GB  * task.attempt }; time = { 4.h   * task.attempt } }
    withLabel:process_medium    { cpus = 4;  memory = { 16.GB * task.attempt }; time = { 12.h  * task.attempt } }
    withLabel:process_sort      { cpus = 4;  memory = { 16.GB * task.attempt }; time = { 12.h  * task.attempt } }
    withLabel:process_high      { cpus = 8;  memory = { 32.GB * task.attempt }; time = { 48.h  * task.attempt } }
    withLabel:process_very_high { cpus = 16; memory = { 64.GB * task.attempt }; time = { 72.h  * task.attempt } }
    withLabel:process_miser     { cpus = 1;  memory = { 64.GB * task.attempt }; time = { 48.h  * task.attempt } }

    // ── MISER-specific SLURM overrides ───────────────────────────────────
    withName: 'MISER' {
        scratch = false   // leave local scratch for MisER's own I/O

        // --tmp requests node-local scratch; SLURM sets $SLURM_TMPDIR automatically.
        // miser.nf's resolver checks $SLURM_TMPDIR as its second candidate
        // (after /scratch0 which won't exist here) and uses it if >= 40 G free.
        clusterOptions = {
            def mpc = (task.memory.mega / task.cpus).toInteger()
            "--account=my_project --mem-per-cpu=${mpc}M --tmp=61440"  // 61440 MB = 60 G
        }
        // containerOptions line not needed on most SLURM sites:
        // SLURM_TMPDIR is visible inside Singularity when autoMounts = true.
        // Uncomment and adjust if your site uses strict mount isolation:
        // containerOptions = "-B \${SLURM_TMPDIR}"
    }
}
