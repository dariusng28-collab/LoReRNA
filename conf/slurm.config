// ============================================================================
// LoReRNA — generic SLURM site config
//
// Tested on standard SLURM clusters (Alma/Rocky Linux 8/9).
// Three things to update for your site:
//   1. singularity.cacheDir   — where SIF images are cached
//   2. queue                  — your partition name
//   3. --account in clusterOptions and MISER clusterOptions
//
// Changes from the SGE config:
//   clusterOptions : SGE -l tmem/h_vmem  →  SLURM --mem-per-cpu
//   scratch flag   : tscratch=60G        →  --tmp=61440  (MB units)
//   scratch path   : /scratch0           →  $SLURM_TMPDIR (set by scheduler)
// ============================================================================

executor {
    name      = 'slurm'
    queueSize = 50
}

// ── Singularity ───────────────────────────────────────────────────────────────
singularity.autoMounts = true
singularity.cacheDir   = "/path/to/singularity_cache"  // ← update

// ── Process defaults ──────────────────────────────────────────────────────────
process {
    // Cluster resource ceiling. Every request is clamped to this (Nextflow >= 24.04).
    resourceLimits = [ cpus: 16, memory: '256.GB', time: '240.h' ]

    executor     = 'slurm'
    queue        = 'compute'   // ← update to your partition
    scratch      = false       // work dirs stay on shared filesystem (symlinks safe)
    beforeScript = 'export PATH=/opt/conda/bin:/usr/bin:/bin:$PATH'

    clusterOptions = {
        def mpc = (task.memory.mega / task.cpus).toInteger()
        "--account=my_project --mem-per-cpu=${mpc}M"   // ← update account
    }
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247]
                      ? 'retry' : 'finish' }
    maxRetries = 2
    maxErrors  = -1

    withLabel:process_single    { cpus = 1;  memory = { 8.GB  * task.attempt };  time = { 12.h * task.attempt } }
    withLabel:process_low       { cpus = 2;  memory = { 8.GB  * task.attempt };  time = { 4.h  * task.attempt } }
    withLabel:process_medium    { cpus = 4;  memory = { 16.GB * task.attempt }; time = { 12.h * task.attempt } }
    withLabel:process_sort      { cpus = 4;  memory = { 16.GB * task.attempt }; time = { 12.h * task.attempt } }
    withLabel:process_high      { cpus = 8;  memory = { 32.GB * task.attempt }; time = { 48.h * task.attempt } }
    withLabel:process_very_high { cpus = 16; memory = { 64.GB * task.attempt }; time = { 72.h * task.attempt } }
    withLabel:process_miser {
        // MisER on 15G BAMs takes ~48h. 72h base, doubles on retry.
        cpus   = 1
        memory = { 64.GB * task.attempt }
        time   = { 72.h  * task.attempt }
    }

    withName: 'MISER' {
        // scratch = false: NF work dir stays on shared FS.
        // MisER manages its own scratch via $SLURM_TMPDIR (set by --tmp).
        scratch        = false
        clusterOptions = {
            def mpc = (task.memory.mega / task.cpus).toInteger()
            "--account=my_project --mem-per-cpu=${mpc}M --tmp=61440"  // 61440 MB = 60 G
        }
        // autoMounts = true means SLURM_TMPDIR is visible inside the container.
        // Only uncomment containerOptions if your site uses strict mount isolation:
        // containerOptions = "-B \${SLURM_TMPDIR}"
    }
}

