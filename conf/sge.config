// ============================================================================
// LoReRNA — example SGE/UGE site config
//
// Copy this file for any SGE/UGE cluster. Only three sections need editing
// for a new site:
//
//   1. singularity.runOptions  — bind mount paths for your filesystem
//   2. singularity.cacheDir    — where pulled SIF images are cached
//   3. withName: 'MISER'       — scratch resource flag and bind mount
//
// Everything else (scratch detection, the 40 G guard, fallback chain,
// parallel BAM cleaning, memory retry scaling) lives in the .nf modules
// and requires no changes.
// ============================================================================

executor {
    name      = 'sge'
    queueSize = 50
}

singularity.autoMounts = false
singularity.runOptions = "-B ${HOME},${PWD},/path/to/shared/filesystem"
singularity.cacheDir   = "/path/to/singularity/cache"

params {
    max_cpus   = 4
    max_memory = '128.GB'
    max_time   = '240.h'
}

process {
    executor     = 'sge'
    penv         = 'smp'
    queue        = 'your.queue'   // ← update
    // scratch = false: with autoMounts = false, $TMPDIR is not bound inside the
    // Singularity container, so all NF work dirs stay on the shared filesystem.
    // MISER manages its own node-local scratch separately (see withName: 'MISER').
    scratch      = false
    beforeScript = 'export PATH=/opt/conda/bin:/usr/bin:/bin:$PATH'
    clusterOptions = {
        def mpc = (task.memory.mega / task.cpus).toInteger()
        "-S /bin/bash -l tmem=${mpc}M,h_vmem=${mpc}M"
    }
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247]
                      ? 'retry' : 'finish' }
    maxRetries = 2
    maxErrors  = -1

    withLabel:process_single    { cpus = 1; memory = { 8.GB  * task.attempt }; time = { 12.h  * task.attempt } }
    withLabel:process_low       { cpus = 2; memory = { 8.GB  * task.attempt }; time = { 4.h   * task.attempt } }
    withLabel:process_medium    { cpus = 4; memory = { 16.GB * task.attempt }; time = { 12.h  * task.attempt } }
    withLabel:process_sort      { cpus = 4; memory = { 16.GB * task.attempt }; time = { 12.h  * task.attempt } }
    withLabel:process_high      { cpus = 4; memory = { 32.GB * task.attempt }; time = { 48.h  * task.attempt } }
    withLabel:process_very_high { cpus = 4; memory = { 64.GB * task.attempt }; time = { 72.h  * task.attempt } }
    withLabel:process_miser     { cpus = 1; memory = { 64.GB * task.attempt }; time = { 48.h  * task.attempt } }

    withName: 'MISER' {
        // 1. Keep NF work dir on shared filesystem — leave /scratch0 free for MisER I/O
        scratch = false

        // 2. Request 60 G node-local scratch from SGE (tscratch resource)
        //    SGE allocates this on /scratch0 before the job starts.
        //    The scratch resolver in miser.nf picks it up automatically.
        clusterOptions = {
            def mpc = (task.memory.mega / task.cpus).toInteger()
            "-S /bin/bash -l tmem=${mpc}M,h_vmem=${mpc}M,tscratch=60G"
        }

        // 3. Bind /scratch0 into the Singularity container
        containerOptions = "-B /scratch0"
    }
}
