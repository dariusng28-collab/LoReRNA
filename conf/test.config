// ============================================================================
// conf/test.config — minimal profile for `-stub-run` CI (DAG wiring test)
//
// This drives the whole pipeline with placeholder inputs and NO real tools or
// data. It only works once every process has a `stub:` block (which touches
// its declared outputs). Combined with `-stub-run` it validates channel
// wiring, emit names, publishDir logic, and param handling in seconds.
//
// Wire it in: in nextflow.config, replace the inline `test { ... }` profile
// with:
//     test { includeConfig 'conf/test.config' }
//
// Then generate the placeholder inputs and run:
//     bash test/make_stub_inputs.sh
//     nextflow run main.nf -profile test -stub-run
// ============================================================================

params {
    // placeholder inputs created by test/make_stub_inputs.sh
    samplesheet     = "${projectDir}/test/data/samplesheet_stub.csv"
    reference_fasta = "${projectDir}/test/data/genome.fa"
    reference_gtf   = "${projectDir}/test/data/annotation.gtf"
    reference_bed12 = "${projectDir}/test/data/annotation.bed12"

    // shrink the statistical steps (irrelevant under -stub-run, but correct
    // if this profile is ever pointed at a real minimal dataset)
    oarfish_num_bootstraps = 2
    swish_nperms           = 2
    swish_min_n            = 1
    swish_top_n            = 5

    publish_mode = 'symlink'
    outdir       = 'stub_results'
}

// Run locally, no scheduler, no container engine needed for -stub-run.
// tiny resource envelope so it fits any CI runner.
process {
    executor       = 'local'
    resourceLimits = [ cpus: 2, memory: '6.GB', time: '1.h' ]
}
