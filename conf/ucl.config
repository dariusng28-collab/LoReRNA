// ============================================================================
// LoReRNA — UCL morecambe2 SGE site config
//
// This file contains UCL-specific paths and is NOT tracked in git.
// See conf/sge.config for the generic SGE template.
//
// Usage:
//   nextflow run main.nf -profile singularity -c conf/ucl.config ...
// ============================================================================

executor {
    name      = 'sge'
    queueSize = 50
}

singularity.autoMounts = false
singularity.runOptions = "-B ${HOME},${PWD},/SAN"
singularity.cacheDir   = "/SAN/vyplab/alb_projects/singularity_cache"

params {
    max_cpus   = 4
    max_memory = '128.GB'
    max_time   = '240.h'
}

process {
    executor     = 'sge'
    penv         = 'smp'
    queue        = 'cpu.q'
    scratch      = false
    beforeScript = 'export PATH=/opt/conda/bin:/usr/bin:/bin:$PATH'
    clusterOptions = {
        def mpc = (task.memory.mega / task.cpus).toInteger()
        "-S /bin/bash -l tmem=${mpc}M,h_vmem=${mpc}M"
    }
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247]
                      ? 'retry' : 'finish' }
    maxRetries = 2
    maxErrors  = -1

    withLabel:process_single    { cpus = 1; memory = { 8.GB  * task.attempt }; time = { 12.h  * task.attempt } }
    withLabel:process_low       { cpus = 2; memory = { 8.GB  * task.attempt }; time = { 4.h   * task.attempt } }
    withLabel:process_medium    { cpus = 4; memory = { 16.GB * task.attempt }; time = { 12.h  * task.attempt } }
    withLabel:process_sort      { cpus = 4; memory = { 16.GB * task.attempt }; time = { 12.h  * task.attempt } }
    withLabel:process_high      { cpus = 4; memory = { 32.GB * task.attempt }; time = { 48.h  * task.attempt } }
    withLabel:process_very_high { cpus = 4; memory = { 64.GB * task.attempt }; time = { 72.h  * task.attempt } }
    withLabel:process_miser     { cpus = 4; memory = { 64.GB * task.attempt }; time = { 72.h  * task.attempt } }

    withName: 'MISER' {
        scratch        = false
        clusterOptions = {
            def mpc = (task.memory.mega / task.cpus).toInteger()
            "-S /bin/bash -l tmem=${mpc}M,h_vmem=${mpc}M,tscratch=60G"
        }
        containerOptions = "-B /scratch0"
    }
}
