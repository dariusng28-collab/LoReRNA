// ============================================================================
// LoReRNA — UCL morecambe2 SGE site config
//
// Two UCL-specific things live here and only here:
//   1. The SGE scratch resource flag  : tscratch=60G  (in MISER clusterOptions)
//   2. The Singularity bind path      : /scratch0     (in MISER containerOptions)
//
// Everything else — scratch detection, the 40 G guard, the fallback chain —
// lives in miser.nf and requires no changes for this site.
//
// To deploy at a new site: copy this file, change the executor block,
// update the two MISER-specific lines, and done.
// ============================================================================

executor {
    name      = 'sge'
    queueSize = 50
}

// ── Singularity ───────────────────────────────────────────────────────────────
// autoMounts = false: all bind mounts are explicit.
// /scratch0 is NOT in the global runOptions — it is added only for MISER
// via containerOptions below, so other processes are not affected.
singularity.autoMounts = false
singularity.runOptions = "-B ${HOME},${PWD},/SAN"
singularity.cacheDir   = "/SAN/vyplab/alb_projects/singularity_cache"

// ── Site resource caps ────────────────────────────────────────────────────────
params {
    max_cpus   = 4
    max_memory = '128.GB'
    max_time   = '240.h'
}

// ── Process defaults ──────────────────────────────────────────────────────────
process {
    executor = 'sge'
    penv     = 'smp'
    queue    = 'cpu.q'
    scratch  = true   // all processes use node-local /tmp as NF work dir,
                      // EXCEPT MISER (overridden below) which needs /tmp
                      // free for its own scratch I/O
    clusterOptions = {
        def mpc = (task.memory.mega / task.cpus).toInteger()
        "-S /bin/bash -l tmem=${mpc}M,h_vmem=${mpc}M"
    }
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247]
                      ? 'retry' : 'finish' }
    maxRetries = 2
    maxErrors  = -1

    // ── Resource label overrides for UCL (caps at max_cpus = 4) ──────────
    withLabel:process_single {
        cpus   = 1
        memory = { 8.GB  * task.attempt }
        time   = { 12.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = 2
        memory = { 8.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }
    withLabel:process_sort {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }
    withLabel:process_high {
        cpus   = 4
        memory = { 32.GB * task.attempt }
        time   = { 48.h  * task.attempt }
    }
    withLabel:process_very_high {
        cpus   = 4
        memory = { 64.GB * task.attempt }
        time   = { 72.h  * task.attempt }
    }
    withLabel:process_miser {
        // MisER: single-threaded, I/O-bound, needs 64 GB minimum.
        // Memory doubles on retry (task.attempt multiplier).
        cpus   = 1
        memory = { 64.GB * task.attempt }
        time   = { 48.h  * task.attempt }
    }

    // ── MISER-specific SGE + Singularity overrides ────────────────────────
    withName: 'MISER' {
        // 1. Do NOT use /tmp as the Nextflow work dir for MISER.
        //    scratch = true would consume /tmp space before MisER's scratch
        //    resolver even runs, making the 40 G check fail on /tmp.
        //    With scratch = false, the NF work dir is on SAN; all 60 G of
        //    tscratch-allocated /scratch0 is available to MisER's I/O.
        scratch = false

        // 2. Request 60 G of node-local scratch from SGE via tscratch.
        //    SGE allocates this on /scratch0 before the job starts.
        //    miser.nf's scratch resolver sees /scratch0 as the first
        //    candidate and uses it automatically.
        clusterOptions = {
            def mpc = (task.memory.mega / task.cpus).toInteger()
            "-S /bin/bash -l tmem=${mpc}M,h_vmem=${mpc}M,tscratch=60G"
        }

        // 3. Bind /scratch0 into the Singularity container.
        //    Without this the container cannot see /scratch0 and the
        //    [ -d /scratch0 ] check in miser.nf always returns false.
        containerOptions = "-B /scratch0"
    }
}
