// ============================================================================
// LoReRNA — generic LSF (bsub) site config
// Tested pattern: Wellcome Sanger Institute, EBI cluster (codon).
//
// Changes from the SGE example:
//   clusterOptions : SGE -l tmem/h_vmem  →  LSF -M/-R rusage[mem=...]
//   scratch flag   : tscratch=60G        →  rusage[scratch=61440]  (MB)
//   scratch path   : /scratch0           →  $TMPDIR (LSF sets this when
//                                            scratch is requested)
//   penv           : SGE smp             →  -n (LSF slot count)
// ============================================================================

executor {
    name      = 'lsf'
    queueSize = 50
    perJobMemLimit = true   // makes Nextflow pass -M per job, not per core
}

// ── Singularity ───────────────────────────────────────────────────────────────
singularity.autoMounts = true
singularity.cacheDir   = "/path/to/shared/singularity_cache"   // ← update

// ── Process defaults ──────────────────────────────────────────────────────────
process {
    // Cluster resource ceiling. Every request is clamped to this (Nextflow >= 24.04).
    resourceLimits = [ cpus: 16, memory: '256.GB', time: '240.h' ]

    executor     = 'lsf'
    queue        = 'normal'     // ← update to your queue
    scratch      = true
    beforeScript = 'export PATH=/opt/conda/bin:/usr/bin:/bin:$PATH'

    clusterOptions = {
        def mem_mb = task.memory.toMega() as int
        "-P my_project -M ${mem_mb} -R 'select[mem>=${mem_mb}] rusage[mem=${mem_mb}]'"
    }
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247]
                      ? 'retry' : 'finish' }
    maxRetries = 2
    maxErrors  = -1

    withLabel:process_single    { cpus = 1;  memory = { 8.GB  * task.attempt }; time = { 12.h  * task.attempt } }
    withLabel:process_low       { cpus = 2;  memory = { 8.GB  * task.attempt }; time = { 4.h   * task.attempt } }
    withLabel:process_medium    { cpus = 4;  memory = { 16.GB * task.attempt }; time = { 12.h  * task.attempt } }
    withLabel:process_sort      { cpus = 4;  memory = { 16.GB * task.attempt }; time = { 12.h  * task.attempt } }
    withLabel:process_high      { cpus = 8;  memory = { 32.GB * task.attempt }; time = { 48.h  * task.attempt } }
    withLabel:process_very_high { cpus = 16; memory = { 64.GB * task.attempt }; time = { 72.h  * task.attempt } }
    withLabel:process_miser     { cpus = 1;  memory = { 64.GB * task.attempt }; time = { 48.h  * task.attempt } }

    withName: 'MISER' {
        scratch = false
        clusterOptions = {
            def mem_mb = task.memory.toMega() as int
            // rusage[scratch=N] requests N MB of local scratch; LSF sets $TMPDIR.
            // miser.nf's resolver picks up $TMPDIR as its fifth fallback candidate.
            "-P my_project -M ${mem_mb} -R 'select[mem>=${mem_mb} && scratch>=61440] rusage[mem=${mem_mb},scratch=61440]'"
        }
    }
}
