/*
========================================================================================
    LoReRNA — per-process module configuration
========================================================================================
    Container routing and publishDir for every process, kept here rather than in the
    module files (nf-core convention) so the published layout can be seen and changed
    in one place.

    Two images are used:
      container_miser   — MisER, pysam, samtools (MISER only)
      container_lorerna — samtools, IsoQuant, oarfish, MultiQC, R (everything else)

    NOTE on caching: `container` IS part of the Nextflow task hash, so changing an
    image invalidates every process it applies to. `publishDir` is NOT hashed — it
    changes where results are written without re-running anything, but a resumed run
    will re-publish cached outputs to the new location.
----------------------------------------------------------------------------------------
*/

process {

    // ── Container routing ────────────────────────────────────────────────────
    // MISER's container is set in its own block below, alongside its publishDir.
    withName: 'SAMTOOLS_SORT_INDEX|SAMTOOLS_STATS|CLEAN_BAM|MISER_QC|MISER_QC_MERGE|ISOQUANT|ISOQUANT_QC|PREPARE_OARFISH_REFERENCE|OARFISH|SWISH|SWISH_PLOTS|MULTIQC' {
        container = params.container_lorerna
    }

    // ── 01 — MisER splice correction and micro-exon QC ───────────────────────
    withName: 'MISER' {
        container  = params.container_miser
        publishDir = [
            path: { "${params.outdir}/01_miser" },
            mode: params.publish_mode
        ]
    }

    withName: 'MISER_QC' {
        publishDir = [
            path: { "${params.outdir}/01_miser_qc/${meta.id}" },
            mode: params.publish_mode
        ]
    }

    withName: 'MISER_QC_MERGE' {
        publishDir = [
            path: { "${params.outdir}/01_miser_qc" },
            mode: params.publish_mode
        ]
    }

    // ── 02 — Sorted and cleaned BAMs ─────────────────────────────────────────
    withName: 'SAMTOOLS_SORT_INDEX' {
        publishDir = [
            path: { "${params.outdir}/02_sorted_bam" },
            mode: params.publish_mode
        ]
    }

    withName: 'CLEAN_BAM' {
        publishDir = [
            path: { "${params.outdir}/02_sorted_bam" },
            mode: params.publish_mode,
            pattern: "*.clean.bam"
        ]
    }

    // ── 03 — IsoQuant transcript discovery ───────────────────────────────────
    // saveAs flattens IsoQuant's nested <sample>/<sample>/ output on publish.
    withName: 'ISOQUANT' {
        publishDir = [
            path: { "${params.outdir}/03_isoquant/${meta.id}" },
            mode: params.publish_mode,
            saveAs: { filename -> filename.tokenize('/')[-1] }
        ]
    }

    // ── 04 — Merged oarfish reference ────────────────────────────────────────
    withName: 'PREPARE_OARFISH_REFERENCE' {
        publishDir = [
            path: { "${params.outdir}/04_oarfish_reference" },
            mode: params.publish_mode
        ]
    }

    // ── 05 — oarfish quantification ──────────────────────────────────────────
    withName: 'OARFISH' {
        publishDir = [
            path: { "${params.outdir}/05_oarfish/${meta.id}" },
            mode: params.publish_mode
        ]
    }

    // ── 06 — swish differential analysis ─────────────────────────────────────
    withName: 'SWISH' {
        publishDir = [
            path: { "${params.outdir}/06_swish" },
            mode: params.publish_mode
        ]
    }

    // saveAs strips the pub_plots/ prefix so PDFs land directly in
    // 06_swish/publication_plots/ rather than a nested pub_plots/ subdirectory.
    withName: 'SWISH_PLOTS' {
        publishDir = [
            path: { "${params.outdir}/06_swish/publication_plots" },
            mode: params.publish_mode,
            saveAs: { it.replaceFirst("pub_plots/", "") }
        ]
    }

    // ── 07 — QC aggregation ──────────────────────────────────────────────────
    withName: 'SAMTOOLS_STATS' {
        publishDir = [
            path: { "${params.outdir}/07_multiqc/samtools" },
            mode: params.publish_mode
        ]
    }

    withName: 'ISOQUANT_QC' {
        publishDir = [
            path: { "${params.outdir}/07_multiqc/isoquant_qc" },
            mode: params.publish_mode
        ]
    }

    withName: 'MULTIQC' {
        publishDir = [
            path: { "${params.outdir}/07_multiqc" },
            mode: params.publish_mode
        ]
    }
}
