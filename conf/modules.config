/*
========================================================================================
    LoReRNA — per-process module configuration
========================================================================================
    Container routing for every process.

    Two images are used:
      container_miser   — MisER, pysam, samtools (MISER only)
      container_lorerna — samtools, IsoQuant, oarfish, MultiQC, R (everything else)

    `publishDir` is currently declared inside each module rather than here. Moving
    it into this file is the nf-core convention and is planned, but it changes
    where results land, so it is done as a separate, verifiable step.

    NOTE: `container` IS part of the Nextflow task hash — changing an image here
    invalidates the cache for every process it applies to.
----------------------------------------------------------------------------------------
*/

process {

    withName: 'MISER' {
        container = params.container_miser
    }

    withName: 'SAMTOOLS_SORT_INDEX|SAMTOOLS_STATS|CLEAN_BAM|MISER_QC|MISER_QC_MERGE|ISOQUANT|ISOQUANT_QC|PREPARE_OARFISH_REFERENCE|OARFISH|SWISH|SWISH_PLOTS|MULTIQC' {
        container = params.container_lorerna
    }
}
