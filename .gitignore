# Nextflow execution artefacts — never commit these
.nextflow/
.nextflow.log*
work/
.nf-test/
.nf-test.log

# Pipeline outputs — results live on SAN, not in git
results/
test_results/
*_results/
*_validation/

# Singularity images — large binaries, pulled at runtime from Docker Hub
*.sif
*.img
singularity_cache/

# Conda environments — rebuilt from environment.yml at runtime
.conda/
conda-envs/

# Nextflow reports — generated at runtime
pipeline_info/
timeline.html
report.html
dag.html
trace.txt

# Editor and OS noise
.DS_Store
.idea/
*.swp
*.swo
*~
__pycache__/
*.pyc
.Rhistory
.RData

# Secrets — never commit credentials or API keys
*.pem
*.key
secrets/

# Large data files — references and BAMs live on SAN
*.bam
*.bai
*.fa
*.fasta
*.fa.gz
*.fasta.gz
*.gtf
*.gff
*.gff3
*.bed
*.bed12
*.db
*.vcf
*.vcf.gz

# Temporary validation samplesheets with real paths
# (template versions with FILL_IN_* are fine to commit)
test/samplesheet_*_real.csv

# Placeholder inputs for -stub-run, regenerated by test/make_stub_inputs.sh
# (CI recreates them on every run, so they are never committed)
test/data/

# Site-specific cluster configs — contain institution paths, queue names,
# cache dirs. Keep on each HPC locally; never commit to the public repo.
conf/ucl.config
conf/*_site.config
conf/my_*.config

# Shiny explorer — swish result tables are collaborator data, not ours to
# publish. The existing results/ rules are directory patterns and do not
# match a loose CSV, so name the files explicitly.
lorerna-explorer/data/
*_full_results.csv
*_all_results.csv
*_all_significant.csv
*_upregulated.csv
*_downregulated.csv
*_increased_usage.csv
*_decreased_usage.csv

# R session and deployment noise
.Rproj.user/
.Rproj.user
rsconnect/

# Windows mark-of-the-web streams, materialised as files on WSL shares
*:Zone.Identifier
